# Copy to .env.local and fill in real values. Never commit real secrets.

# Canonical public origin used by Origin checks and metadata.
NEXT_PUBLIC_SITE_URL=https://chhathmahaparv.org

# Trusted client-IP header. Only set this when your reverse proxy overwrites
# the header (e.g. x-real-ip behind nginx, cf-connecting-ip behind Cloudflare
# with an origin firewall). Vercel/Cloudflare Pages are auto-detected.
# TRUSTED_PROXY_HEADER=x-real-ip

# Shared rate-limit and single-use PoW state across serverless instances.
# Without these, each instance uses a bounded in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV equivalents are also supported:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 32+ character secret for signing PoW challenges. Set this in production so
# challenges validate across instances.
POW_SECRET=

# Supabase writes use the service-role key on the server only. Never expose it
# with a NEXT_PUBLIC_ prefix or import this module into a client component.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
